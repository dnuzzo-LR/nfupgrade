#! /usr/bin/ksh
#
# nf_install — fresh install of netFLEX CORE on the local host, with resume.
#
#   Usage: nf_install -c <config file> -i|-r|-x [-h]
#
#     -c: config file (sourced; INCLOGDIR, NEW_GENERIC, NEW_LOAD, DEPOTFILE,
#         CNCCNFG, INSTALLWEBGUI)
#     -i: fresh install (refused if an install is unfinished or netFLEX is
#         already present)
#     -r: resume an unfinished install from its recorded step
#     -x: reset a failed install: remove only what it provably created
#         (RPM, the two links, the load dir), archive state/info
#     -h: show this help
#
# Runs as root. Re-runs itself in the background (like nf_upgrade launching
# nf_upgrader) unless NFI_FOREGROUND=YES or NFI_CHILD is set.
#
# State: ${INCLOGDIR}/.${HOSTNAME}_INSTALL_STATE holds the step to run NEXT; a
# fatal step exits 1 leaving the state at that step (the resume point). Info:
# ${INCLOGDIR}/.${HOSTNAME}_INSTALL_INFO (LOADDIR, VERSION, DEPOTFILE). Never
# touches ${INCLOGDIR}/.${HOSTNAME}_STATE (nf_upgrader's resume point).
#
# ksh88-safe: no arrays, no PIPESTATUS, no pipefail.

trap '' HUP
umask 022

PATH=${PATH}:/usr/sbin:/sbin
export PATH
NF_LOG_LIB="$(dirname "$0")/nf_log.ksh"
if [ ! -r "${NF_LOG_LIB}" ]
then
	print -u2 "nf_install: cannot read ${NF_LOG_LIB}"
	exit 1
fi
. "${NF_LOG_LIB}"

PROG=${0##*/}

# Roots: overridable so the test suite can run in a sandbox.
INCROOT=${NFI_INCROOT:-/usr/cnc}
STAGEROOT=${NFI_STAGEROOT:-/usr/cnc_stage}
LOADROOT=${NFI_LOADROOT:-/usr4}
MSGMNB_FILE=${NFI_MSGMNB_FILE:-/proc/sys/kernel/msgmnb}
HTTPD_CONF=${NFI_HTTPD_CONF:-/etc/httpd/conf/httpd.conf}
MPM_CONF=${NFI_MPM_CONF:-/etc/httpd/conf.modules.d/00-mpm.conf}

# All valid states, in order. The state file holds the step to run next.
INSTALL_STATES="isstart isprepare isrpm isunstage iscnfg ispackages iscmmperm islicmigrate ispostinstall isdatabase iswebgui islicense isdone"

function print_usage
{
	print -u2 "Usage: ${PROG} -c <config file> -i|-r|-x [-h]"
	print -u2 "   -c: config file"
	print -u2 "   -i: fresh install"
	print -u2 "   -r: resume an unfinished install"
	print -u2 "   -x: reset a failed install"
	print -u2 "   -h: show this help"
}

# die <message> — log FATAL and exit 1. The state file is NOT advanced, so it
# still names the failed step (the resume point).
function die
{
	logfatal "$1"
	logfatal "Aborting install"
	exit 1
}

function write_state
{
	printf '%s\n' "$1" > "${STATEFILE}"
}

# read_state — print the recorded state (first line, blanks stripped), or
# nothing if the file is absent/empty.
function read_state
{
	[ -f "${STATEFILE}" ] || return 0
	sed -e '1!d' -e 's/[[:space:]]//g' "${STATEFILE}"
}

# info_value <KEY> — the value of KEY= from the info file (not sourced).
function info_value
{
	[ -f "${INFOFILE}" ] || return 0
	sed -n "s/^$1=//p" "${INFOFILE}" | sed -n '$p'
}

# state_index <state> — the 0-based position of <state> in INSTALL_STATES
# (nothing printed for an unknown state).
function state_index
{
	typeset s
	integer i=0
	for s in ${INSTALL_STATES}
	do
		if [ "$1" = "$s" ]
		then
			print ${i}
			return 0
		fi
		i=i+1
	done
	return 1
}

function is_valid_state
{
	typeset s
	for s in ${INSTALL_STATES}
	do
		[ "$1" = "$s" ] && return 0
	done
	return 1
}

function netflex_rpm_installed
{
	rpm -q netFLEX-CORE >/dev/null 2>&1
}

# --- steps --------------------------------------------------------------------

# Fresh-start guard (never run on resume): netFLEX must not be present. A
# leftover ${STAGEROOT} (real dir or any link) also refuses: isprepare would
# refuse it anyway, but only after state was written, leaving a resume point
# that can never get past isprepare (ruling R9).
function check_not_installed
{
	if netflex_rpm_installed
	then
		die "netFLEX-CORE RPM is already installed - refusing a fresh install"
	fi
	if [ -e "${INCROOT}" -o -L "${INCROOT}" ]
	then
		die "${INCROOT} already exists - refusing a fresh install"
	fi
	if [ -e "${STAGEROOT}" -o -L "${STAGEROOT}" ]
	then
		die "${STAGEROOT} already exists - refusing a fresh install"
	fi
	loginfo "netFLEX is not installed on ${HOSTNAME}"
}

function check_loadroot_mounted
{
	# (no "if !": ksh88 has no pipeline negation)
	if mountpoint -q "${LOADROOT}"
	then
		loginfo "${LOADROOT} is mounted"
	else
		die "${LOADROOT} is not a mounted filesystem"
	fi
}

function do_isstart
{
	check_loadroot_mounted
}

# link_to_loaddir <link> — create <link> -> LOADDIR, accept an existing link
# already pointing there, refuse anything else.
function link_to_loaddir
{
	typeset link="$1"
	typeset target
	if [ -L "${link}" ]
	then
		target=$(readlink "${link}")
		if [ "${target}" = "${LOADDIR}" ]
		then
			loginfo "${link} already points to ${LOADDIR}"
			return 0
		fi
		die "${link} is a link to ${target}, not ${LOADDIR}"
	fi
	if [ -e "${link}" ]
	then
		die "${link} exists and is not a link to ${LOADDIR}"
	fi
	run_logged ln ln -s "${LOADDIR}" "${link}" || die "cannot link ${link} to ${LOADDIR}"
	loginfo "Linked ${link} -> ${LOADDIR}"
}

# do_isprepare — create LOADDIR and the links. LOADDIR_CREATED=yes is recorded
# in the info file only when this install actually creates LOADDIR (ruling R5),
# so reset never removes a directory it cannot prove is ours. The info file is
# only appended to, so a resumed isprepare keeps an earlier marker.
function do_isprepare
{
	if [ -e "${LOADDIR}" -o -L "${LOADDIR}" ]
	then
		if [ "$(info_value LOADDIR_CREATED)" = "yes" ]
		then
			loginfo "${LOADDIR} already created by this install"
		else
			loginfo "Using existing directory ${LOADDIR} (not created by this install)"
		fi
	else
		run_logged mkdir mkdir -p "${LOADDIR}" || die "cannot create ${LOADDIR}"
		printf 'LOADDIR_CREATED=yes\n' >> "${INFOFILE}" || die "cannot record LOADDIR_CREATED in ${INFOFILE}"
		loginfo "Created ${LOADDIR}"
	fi
	link_to_loaddir "${INCROOT}"
	link_to_loaddir "${STAGEROOT}"
}

function do_isrpm
{
	typeset have want pkgtool
	if netflex_rpm_installed
	then
		have=$(rpm -q --qf '%{VERSION}-%{RELEASE}' netFLEX-CORE 2>/dev/null)
		want=$(rpm -qp --qf '%{VERSION}-%{RELEASE}' "${DEPOTFILE}" 2>/dev/null)
		if [ -n "${have}" -a "${have}" = "${want}" ]
		then
			loginfo "netFLEX-CORE ${have} already installed"
			return 0
		fi
		die "netFLEX-CORE ${have} is installed but ${DEPOTFILE} is ${want}"
	fi
	[ -r "${DEPOTFILE}" ] || die "cannot read DEPOTFILE ${DEPOTFILE}"
	if [ -n "${NFI_PKGTOOL}" ]
	then
		pkgtool="${NFI_PKGTOOL}"
	elif [ -x /usr/bin/dnf ]
	then
		pkgtool=dnf
	else
		pkgtool=yum
	fi
	loginfo "Installing ${DEPOTFILE} with ${pkgtool}"
	run_logged rpm "${pkgtool}" install -y "${DEPOTFILE}" || die "RPM install of ${DEPOTFILE} failed"
	loginfo "RPM install complete"
}

# do_isunstage — remove the ${STAGEROOT} link, but only if it is ours (points
# at LOADDIR); a link elsewhere or a real directory is refused untouched.
function do_isunstage
{
	typeset target
	if [ -L "${STAGEROOT}" ]
	then
		target=$(readlink "${STAGEROOT}")
		if [ "${target}" != "${LOADDIR}" ]
		then
			die "${STAGEROOT} is a link to ${target}, not ${LOADDIR} - not removing it"
		fi
		run_logged unstage rm -f "${STAGEROOT}" || die "cannot remove ${STAGEROOT}"
		loginfo "Removed ${STAGEROOT} link"
	elif [ -e "${STAGEROOT}" ]
	then
		die "${STAGEROOT} is not a link - not removing it"
	else
		loginfo "${STAGEROOT} already absent"
	fi
}

function do_iscnfg
{
	[ -n "${CNCCNFG}" -a -r "${CNCCNFG}" ] || die "cannot read CNCCNFG ${CNCCNFG}"
	run_logged cnccnfg cp "${CNCCNFG}" "${INCROOT}/features/cnc.cnfg" \
		|| die "cannot copy ${CNCCNFG} to ${INCROOT}/features/cnc.cnfg"
	loginfo "Installed ${INCROOT}/features/cnc.cnfg"
}

function do_ispackages
{
	run_logged linux_packages "${INCROOT}/bin/linux_packages" || die "linux_packages failed"
	loginfo "linux_packages complete"
}

function do_iscmmperm
{
	run_logged cmmperm su cmm -c "${INCROOT}/bin/cmmperm" || die "cmmperm failed"
	loginfo "cmmperm complete"
}

function do_islicmigrate
{
	if run_logged license-migrate su cmm -c "${INCROOT}/mbin/license-migrate"
	then
		loginfo "license-migrate complete"
	else
		logwarn "license-migrate failed - continuing"
	fi
}

# set_inc_queue_size — boot_nms (test_unix_parms) refuses to boot unless
# system_defines' INC_QUEUE_SIZE is at least kernel.msgmnb, and the shipped
# value (1048576) is below the 4194304 linux_packages sets. Raise it to the
# larger of 4194304 and the running msgmnb; never lower it. A failure only
# warns: the pre-flight check inc_queue_size (with its Fix) still catches it.
function set_inc_queue_size
{
	typeset sd need cur
	sd="${INCROOT}/features/system_defines"
	need=4194304
	cur=$(cat "${MSGMNB_FILE}" 2>/dev/null)
	case "${cur}" in
	""|*[!0-9]*) ;;
	*) [ "${cur}" -gt "${need}" ] && need=${cur} ;;
	esac
	if [ ! -f "${sd}" ]
	then
		logwarn "No ${sd} - INC_QUEUE_SIZE not set"
		return 0
	fi
	cur=$(sed -n 's/^INC_QUEUE_SIZE=//p' "${sd}" | tail -1)
	case "${cur}" in
	""|*[!0-9]*) ;;
	*)
		if [ "${cur}" -ge "${need}" ]
		then
			loginfo "INC_QUEUE_SIZE=${cur} already at least ${need}"
			return 0
		fi
		;;
	esac
	if grep '^INC_QUEUE_SIZE=' "${sd}" >/dev/null 2>&1
	then
		run_logged incqueue sed -i "s/^INC_QUEUE_SIZE=.*/INC_QUEUE_SIZE=${need}/" "${sd}"
	else
		run_logged incqueue sh -c "echo INC_QUEUE_SIZE=${need} >> '${sd}'"
	fi
	if [ $? -eq 0 ]
	then
		loginfo "INC_QUEUE_SIZE set to ${need} (was ${cur:-unset})"
	else
		logwarn "Could not set INC_QUEUE_SIZE=${need} in ${sd} - continuing"
	fi
	return 0
}

function do_ispostinstall
{
	run_logged post-install "${INCROOT}/bin/post-install.sh" || die "post-install.sh failed"
	loginfo "post-install complete"
	set_inc_queue_size
}

function do_isdatabase
{
	run_logged database "${INCROOT}/bin/nf_upgrade_pg.sh" || die "nf_upgrade_pg.sh failed"
	loginfo "database setup complete"
	# cmmperm's first run (iscmmperm) predates the postgres/pgbouncer users the
	# database step creates, so their chowns fail there; run it again now.
	if run_logged cmmperm su cmm -c "${INCROOT}/bin/cmmperm"
	then
		loginfo "cmmperm re-run after database setup complete"
	else
		logwarn "cmmperm re-run after database setup failed - continuing"
	fi
}

# webgui_setup — the nf-install 530gui.sh sequence. Runs in a subshell (it
# changes directory); returns non-zero at the first failure.
function webgui_setup
{
	typeset tarfile f
	tarfile=""
	for f in "${INCROOT}"/GUI_REL/LINUXWEB64.*.tar
	do
		if [ -f "${f}" ]
		then
			tarfile="${f}"
			break
		fi
	done
	if [ -z "${tarfile}" ]
	then
		logwarn "No LINUXWEB64.*.tar in ${INCROOT}/GUI_REL"
		return 1
	fi
	loginfo "Installing web GUI from ${tarfile}"
	PATH=${PATH}:${INCROOT}/web/bin:${INCROOT}/bin:${INCROOT}/web/data
	cd "${INCROOT}/GUI_REL" || return 1
	run_logged webtar tar xof "${tarfile}" || return 1
	run_logged lwebsetup ./lwebsetup <<EOF || return 1
n
n
EOF
	cd "${INCROOT}/web/data" || return 1
	run_logged maps cp "${INCROOT}"/web/maps.default/* "${INCROOT}/web/maps" || return 1
	# cpjsmap.osm (from nf-install's 530gui.sh) is not shipped by every netFLEX
	# release (absent in 5.5); without it only the jsmap step is skipped.
	if whence cpjsmap.osm >/dev/null 2>&1
	then
		run_logged cpjsmap cpjsmap.osm jsmap || logwarn "cpjsmap.osm failed - jsmap not generated"
	else
		logwarn "cpjsmap.osm not found - jsmap not generated"
	fi
	run_logged sysconfig cp -p def.sys_config.flx sys_config || return 1
	run_logged sysdefines cp -p def.system_defines.flx system_defines || return 1
	# Short host name only: the web GUI looks up "<section>.host" and splits it
	# at the FIRST dot (fndprop, gui/src/web/prop.c), so an FQDN section such as
	# [h.example.com_i] reads back as no host and protocol telnet, and every
	# GUI login fails.
	typeset shorthost="${HOSTNAME%%.*}"
	printf '[%s_i]\n   host=%s\n   protocol=ssh\n' "${shorthost}" "${shorthost}" > ./Interfaces || return 1
	run_logged webchown chown cmm:cmm sys_config system_defines Interfaces || return 1
	return 0
}

# console_ssh_setup — install guide step 11: as cmm, accept this host's ssh
# key (the GUI logs in as console over ssh to the Interfaces host, the short
# name; the FQDN is added too), then copy cmm's .ssh and login/.profile into
# login/console. ssh-keyscan replaces the guide's interactive "ssh `hostname`".
# Returns non-zero at the first failure (the caller warns).
function console_ssh_setup
{
	typeset sshdir kh h names
	sshdir="${INCROOT}/cmm/.ssh"
	kh="${sshdir}/known_hosts"
	names="${HOSTNAME%%.*}"
	[ "${HOSTNAME}" != "${names}" ] && names="${names} ${HOSTNAME}"
	run_logged sshdir su cmm -c "mkdir -p '${sshdir}' && chmod 700 '${sshdir}'" || return 1
	for h in ${names}
	do
		if ssh-keygen -F "${h}" -f "${kh}" >/dev/null 2>&1
		then
			loginfo "${h} already in ${kh}"
			continue
		fi
		run_logged keyscan su cmm -c "ssh-keyscan '${h}' >> '${kh}'" || return 1
		ssh-keygen -F "${h}" -f "${kh}" >/dev/null 2>&1 || return 1
		loginfo "Added ${h}'s ssh host key to ${kh}"
	done
	run_logged consolessh su cmm -c \
		"cp -rp '${sshdir}' '${INCROOT}/login/console/' && cp -p '${INCROOT}/login/.profile' '${INCROOT}/login/console/'" \
		|| return 1
	loginfo "Copied ${sshdir} and login/.profile to ${INCROOT}/login/console"
	return 0
}

# edit_conf <file> <label> <sed args...> — apply the sed edit; if it changes
# the file, keep a timestamped backup and rewrite the file in place (cat >, so
# owner, mode and SELinux label stay). Sets EDIT_BAK to the backup ("" when
# already configured). Non-zero on failure, file untouched.
function edit_conf
{
	typeset f="$1" label="$2" tmp
	shift 2
	EDIT_BAK=""
	tmp="${f}.nfinstall.$$"
	sed "$@" "${f}" > "${tmp}" || { rm -f "${tmp}"; return 1; }
	if cmp -s "${f}" "${tmp}"
	then
		rm -f "${tmp}"
		loginfo "${f} already set (${label})"
		return 0
	fi
	EDIT_BAK="${f}.pre-nfinstall.$(date '+%Y%m%d%H%M%S')"
	if cp -p "${f}" "${EDIT_BAK}" && cat "${tmp}" > "${f}"
	then
		rm -f "${tmp}"
		loginfo "Edited ${f} (${label}); backup ${EDIT_BAK}"
		return 0
	fi
	rm -f "${tmp}"
	EDIT_BAK=""
	return 1
}

# apache_setup — install guide steps 16 and 17, which a stock RHEL httpd
# needs before the GUI works:
#  16 httpd.conf: User/Group cmm (web_intrfc is setuid cmm and grantpt() on
#     its ssh pty fails unless Apache's real uid is cmm too) and "Require all
#     granted" in <Directory /> (netFLEX's webgui.conf grants nothing itself).
#  17 00-mpm.conf: prefork instead of event (with event, CGIs go through
#     mod_cgid's socket in /run/httpd, which a cmm worker cannot reach).
# Each changed file is backed up; a failed check or configtest puts both back.
# Returns non-zero on failure (the caller warns).
function apache_setup
{
	typeset hbak mbak
	if [ ! -f "${HTTPD_CONF}" -o ! -f "${MPM_CONF}" ]
	then
		logwarn "No ${HTTPD_CONF} or ${MPM_CONF} - is httpd installed?"
		return 1
	fi
	edit_conf "${HTTPD_CONF}" "step 16: User/Group cmm, <Directory /> granted" \
		-e 's/^User .*/User cmm/' -e 's/^Group .*/Group cmm/' \
		-e '/^<Directory \/>/,/^<\/Directory>/s/Require all denied/Require all granted/' \
		|| return 1
	hbak="${EDIT_BAK}"
	edit_conf "${MPM_CONF}" "step 17: prefork MPM" \
		-e 's/^LoadModule mpm_event_module/#&/' -e 's/^LoadModule mpm_worker_module/#&/' \
		-e 's/^#[[:space:]]*\(LoadModule mpm_prefork_module\)/\1/' \
		|| { apache_restore "${hbak}" ""; return 1; }
	mbak="${EDIT_BAK}"
	apache_check || { apache_restore "${hbak}" "${mbak}"; return 1; }
	if run_logged apachectl apachectl configtest
	then
		:
	else
		logwarn "apachectl configtest failed - restoring the Apache config"
		apache_restore "${hbak}" "${mbak}"
		return 1
	fi
	run_logged httpd systemctl restart httpd || return 1
	loginfo "Apache configured (install guide steps 16-17) and restarted"
	return 0
}

# apache_check — the edits took: User/Group cmm, <Directory /> not denied,
# exactly one MPM loaded and it is prefork. Logs what is wrong.
function apache_check
{
	typeset ok=0
	grep '^User cmm$' "${HTTPD_CONF}" >/dev/null 2>&1 || { logwarn "${HTTPD_CONF}: no 'User cmm'"; ok=1; }
	grep '^Group cmm$' "${HTTPD_CONF}" >/dev/null 2>&1 || { logwarn "${HTTPD_CONF}: no 'Group cmm'"; ok=1; }
	if [ -n "$(sed -n '/^<Directory \/>/,/^<\/Directory>/p' "${HTTPD_CONF}" | grep 'Require all denied')" ]
	then
		logwarn "${HTTPD_CONF}: <Directory /> still denies"
		ok=1
	fi
	# (no "!": ksh88 has no pipeline negation)
	if [ "$(grep -c '^LoadModule mpm_' "${MPM_CONF}")" != 1 \
		-o "$(grep -c '^LoadModule mpm_prefork_module' "${MPM_CONF}")" != 1 ]
	then
		logwarn "${MPM_CONF}: prefork is not the only MPM loaded"
		ok=1
	fi
	return ${ok}
}

# apache_restore <httpd.conf backup> <00-mpm.conf backup> — put back whichever
# file edit_conf changed ("" = unchanged).
function apache_restore
{
	[ -n "$1" ] && cat "$1" > "${HTTPD_CONF}" && loginfo "Restored ${HTTPD_CONF} from $1"
	[ -n "$2" ] && cat "$2" > "${MPM_CONF}" && loginfo "Restored ${MPM_CONF} from $2"
	return 0
}

function do_iswebgui
{
	if [ "${INSTALLWEBGUI}" = "NO" ]
	then
		loginfo "Web GUI install skipped (INSTALLWEBGUI=NO)"
		return 0
	fi
	if ( webgui_setup )
	then
		loginfo "Web GUI install complete"
	else
		logwarn "Web GUI install failed - continuing without it"
		return 0
	fi
	if console_ssh_setup
	then
		:
	else
		logwarn "console ssh setup (install guide step 11) failed - GUI logins may fail; do it by hand"
	fi
	if apache_setup
	then
		:
	else
		logwarn "Apache setup (install guide steps 16-17) failed - the GUI may answer 403 or refuse logins; do it by hand"
	fi
}

function do_islicense
{
	loginfo "license setup not yet implemented - skipped"
}

# --- master loop --------------------------------------------------------------

function run_install
{
	STATE=$(read_state)
	while true
	do
		loginfo "Current install STATE is ${STATE}"
		case ${STATE} in
		isstart )       do_isstart;       STATE=isprepare ;;
		isprepare )     do_isprepare;     STATE=isrpm ;;
		isrpm )         do_isrpm;         STATE=isunstage ;;
		isunstage )     do_isunstage;     STATE=iscnfg ;;
		iscnfg )        do_iscnfg;        STATE=ispackages ;;
		ispackages )    do_ispackages;    STATE=iscmmperm ;;
		iscmmperm )     do_iscmmperm;     STATE=islicmigrate ;;
		islicmigrate )  do_islicmigrate;  STATE=ispostinstall ;;
		ispostinstall ) do_ispostinstall; STATE=isdatabase ;;
		isdatabase )    do_isdatabase;    STATE=iswebgui ;;
		iswebgui )      do_iswebgui;      STATE=islicense ;;
		islicense )     do_islicense;     STATE=isdone ;;
		isdone )
			loginfo "netFLEX install of ${VERSION} on ${HOSTNAME} complete"
			break
			;;
		* )
			die "Unsupported install state (${STATE})"
			;;
		esac
		write_state "${STATE}"
	done
}

# Fresh start (-i). Order matters (ruling R1): refuse an unfinished install
# first, then run the not-installed guard and the mount check, and only then
# archive a finished state and write new state/info files, so a refused
# install never leaves a resumable state behind.
function start_fresh
{
	typeset cur ts
	cur=$(read_state)
	if [ -n "${cur}" -a "${cur}" != "isdone" ]
	then
		die "unfinished install (state ${cur}) on ${HOSTNAME} - use resume or reset"
	fi
	check_not_installed
	check_loadroot_mounted
	[ -n "${DEPOTFILE}" -a -f "${DEPOTFILE}" -a -r "${DEPOTFILE}" ] \
		|| die "cannot read DEPOTFILE ${DEPOTFILE} - refusing a fresh install"
	[ -n "${CNCCNFG}" -a -f "${CNCCNFG}" -a -r "${CNCCNFG}" ] \
		|| die "cannot read CNCCNFG ${CNCCNFG} - refusing a fresh install"
	if [ "${cur}" = "isdone" ]
	then
		ts=$(date '+%Y%m%d%H%M%S')
		run_logged archive mv "${STATEFILE}" "${STATEFILE}.${ts}" || die "cannot archive ${STATEFILE}"
		if [ -f "${INFOFILE}" ]
		then
			run_logged archive mv "${INFOFILE}" "${INFOFILE}.${ts}" || die "cannot archive ${INFOFILE}"
		fi
		loginfo "Archived previous install state as ${STATEFILE}.${ts}"
	fi
	{
		printf 'LOADDIR=%s\n' "${LOADDIR}"
		printf 'VERSION=%s\n' "${VERSION}"
		printf 'DEPOTFILE=%s\n' "${DEPOTFILE}"
	} > "${INFOFILE}" || die "cannot write ${INFOFILE}"
	write_state isstart
	loginfo "Starting fresh install of ${VERSION} into ${LOADDIR}"
}

# Resume (-r). Requires an unfinished state; skips the not-installed guard.
# Once isprepare has run, the install owns ${INCROOT} (a link to LOADDIR) and
# ${STAGEROOT} (that link, or removed by isunstage): resume refuses, changing
# nothing, if either is anything else, so it never runs install steps over a
# netFLEX it did not create.
function start_resume
{
	typeset cur infoload target
	integer idx prep
	cur=$(read_state)
	if [ -z "${cur}" -o "${cur}" = "isdone" ]
	then
		die "no unfinished install to resume on ${HOSTNAME}"
	fi
	is_valid_state "${cur}" || die "Unsupported install state (${cur}) in ${STATEFILE}"
	infoload=$(info_value LOADDIR)
	[ -n "${infoload}" ] || die "no LOADDIR in ${INFOFILE} - cannot resume"
	if [ "${infoload}" != "${LOADDIR}" ]
	then
		die "install in progress is for ${infoload} but the config names ${LOADDIR} - use reset"
	fi
	LOADDIR="${infoload}"
	idx=$(state_index "${cur}")
	prep=$(state_index isprepare)
	if [ ${idx} -gt ${prep} ]
	then
		if [ -L "${INCROOT}" ]
		then
			target=$(readlink "${INCROOT}")
			[ "${target}" = "${LOADDIR}" ] \
				|| die "${INCROOT} is a link to ${target}, not ${LOADDIR} - refusing resume, nothing changed"
		else
			die "${INCROOT} is not a link to ${LOADDIR} - refusing resume, nothing changed"
		fi
		reset_link_ok "${STAGEROOT}" \
			|| die "${STAGEROOT} is not ours - refusing resume, nothing changed"
	fi
	loginfo "Resuming install of ${VERSION} into ${LOADDIR} at step ${cur}"
}

# reset_link_ok <link> — succeed if <link> is absent, or is a symlink whose
# readlink equals LOADDIR. Anything else (a real file/dir, or a link elsewhere)
# is not provably ours.
function reset_link_ok
{
	typeset link="$1"
	typeset target
	if [ -L "${link}" ]
	then
		target=$(readlink "${link}")
		if [ "${target}" = "${LOADDIR}" ]
		then
			return 0
		fi
		logerror "${link} is a link to ${target}, not ${LOADDIR}"
		return 1
	fi
	if [ -e "${link}" ]
	then
		logerror "${link} exists and is not a link to ${LOADDIR}"
		return 1
	fi
	return 0
}

# Reset (-x): undo a failed install, removing ONLY what it provably created.
# Every refusal check runs before anything is removed; a refusal is FATAL and
# leaves the RPM, links, load dir, state and info untouched. The load dir is
# removed only if the info file says this install created it (LOADDIR_CREATED).
# Traces are kept.
function do_reset
{
	typeset cur infoload rest ts rpmout rpmrc
	cur=$(read_state)
	if [ -z "${cur}" -o "${cur}" = "isdone" ]
	then
		die "no unfinished install to reset on ${HOSTNAME} (state ${cur:-none})"
	fi
	is_valid_state "${cur}" || die "Unsupported install state (${cur}) in ${STATEFILE}"
	infoload=$(info_value LOADDIR)
	[ -n "${infoload}" ] || die "no LOADDIR in ${INFOFILE} - refusing reset"
	# LOADDIR must be ${LOADROOT}/inc<something>, one path component, so a
	# tampered info file (other dir, "..", nested path) cannot widen the rm -rf.
	case "${infoload}" in
	"${LOADROOT}"/inc*) rest="${infoload#${LOADROOT}/inc}" ;;
	*) die "LOADDIR ${infoload} is not under ${LOADROOT}/inc - refusing reset" ;;
	esac
	case "${rest}" in
	""|*/*|*..*) die "LOADDIR ${infoload} is not a ${LOADROOT}/inc load dir - refusing reset" ;;
	esac
	LOADDIR="${infoload}"
	reset_link_ok "${INCROOT}" || die "${INCROOT} is not ours - refusing reset, nothing removed"
	reset_link_ok "${STAGEROOT}" || die "${STAGEROOT} is not ours - refusing reset, nothing removed"
	loginfo "Resetting failed install (state ${cur}) of ${LOADDIR} on ${HOSTNAME}"

	# Probe with its output logged, so an rpmdb error that reads as "not
	# installed" is visible in the trace.
	rpmout=$(rpm -q netFLEX-CORE 2>&1)
	rpmrc=$?
	loginfo "rpm -q netFLEX-CORE (rc ${rpmrc}): ${rpmout}"
	if [ ${rpmrc} -eq 0 ]
	then
		run_logged rpm rpm -e netFLEX-CORE || die "rpm -e netFLEX-CORE failed"
		loginfo "Removed netFLEX-CORE RPM"
	else
		loginfo "netFLEX-CORE RPM not installed"
	fi
	if [ -L "${INCROOT}" ]
	then
		run_logged unlink rm -f "${INCROOT}" || die "cannot remove ${INCROOT}"
		loginfo "Removed ${INCROOT} link"
	fi
	if [ -L "${STAGEROOT}" ]
	then
		run_logged unlink rm -f "${STAGEROOT}" || die "cannot remove ${STAGEROOT}"
		loginfo "Removed ${STAGEROOT} link"
	fi
	if [ "$(info_value LOADDIR_CREATED)" != "yes" ]
	then
		logwarn "${LOADDIR} was not created by this install - left in place"
	elif [ -e "${LOADDIR}" -o -L "${LOADDIR}" ]
	then
		run_logged loaddir rm -rf "${LOADDIR}" || die "cannot remove ${LOADDIR}"
		loginfo "Removed ${LOADDIR}"
	fi
	ts=$(date '+%Y%m%d%H%M%S')
	run_logged archive mv "${STATEFILE}" "${STATEFILE}.${ts}" || die "cannot archive ${STATEFILE}"
	if [ -f "${INFOFILE}" ]
	then
		run_logged archive mv "${INFOFILE}" "${INFOFILE}.${ts}" || die "cannot archive ${INFOFILE}"
	fi
	loginfo "Archived install state as ${STATEFILE}.${ts}"
	loginfo "reset complete"
}

# --- main -----------------------------------------------------------------------

ACTION=""
ACTIONFLAG=""
CONFIGFILE=""
integer NACTIONS=0
while getopts "c:irxh" c
do
	case $c in
	c) CONFIGFILE=${OPTARG} ;;
	i) ACTION=install; ACTIONFLAG=-i; NACTIONS=NACTIONS+1 ;;
	r) ACTION=resume;  ACTIONFLAG=-r; NACTIONS=NACTIONS+1 ;;
	x) ACTION=reset;   ACTIONFLAG=-x; NACTIONS=NACTIONS+1 ;;
	h) print_usage; exit 0 ;;
	*) print_usage; exit 1 ;;
	esac
done

if [ ${NACTIONS} -ne 1 ]
then
	logerror "Must provide one and only one of -i, -r or -x"
	print_usage
	exit 1
fi
if [ -z "${CONFIGFILE}" ]
then
	logerror "No config file given (-c)"
	print_usage
	exit 1
fi
case "${CONFIGFILE}" in
*/*) ;;
*) CONFIGFILE="./${CONFIGFILE}" ;;
esac
if [ ! -f "${CONFIGFILE}" -o ! -r "${CONFIGFILE}" ]
then
	logerror "Config file (${CONFIGFILE}) not found"
	exit 1
fi
. "${CONFIGFILE}"

if [ -z "${INCLOGDIR}" -o ! -d "${INCLOGDIR}" -o ! -w "${INCLOGDIR}" ]
then
	logerror "INCLOGDIR [${INCLOGDIR}] is not a writable directory"
	exit 1
fi
if [ -z "${NEW_GENERIC}" -o -z "${NEW_LOAD}" ]
then
	logerror "NEW_GENERIC and NEW_LOAD must be set in ${CONFIGFILE}"
	exit 1
fi

# Re-run in the background, detached, like nf_upgrade launching nf_upgrader.
if [ "${NFI_FOREGROUND}" != "YES" -a -z "${NFI_CHILD}" ]
then
	NFI_CHILD=1 nohup "$0" -c "${CONFIGFILE}" ${ACTIONFLAG} </dev/null >/dev/null 2>&1 &
	exit 0
fi

HOSTNAME=$(hostname)
if [ -z "${HOSTNAME}" ]
then
	logerror "Cannot determine host name"
	exit 1
fi
STATEFILE="${INCLOGDIR}/.${HOSTNAME}_INSTALL_STATE"
INFOFILE="${INCLOGDIR}/.${HOSTNAME}_INSTALL_INFO"
LOADDIR="${LOADROOT}/inc${NEW_GENERIC}${NEW_LOAD}"
VERSION="${NEW_GENERIC}.${NEW_LOAD}"

if [ "${ACTION}" = "reset" ]
then
	TRACEFILE="${INCLOGDIR}/reset_inc_${HOSTNAME}.$$"
else
	TRACEFILE="${INCLOGDIR}/install_inc_${HOSTNAME}.$$"
fi
exec >>"${TRACEFILE}" 2>&1

loginfo "${PROG} ${ACTIONFLAG} started on ${HOSTNAME} (pid $$, config ${CONFIGFILE})"

case ${ACTION} in
install)
	start_fresh
	run_install
	;;
resume)
	start_resume
	run_install
	;;
reset)
	do_reset
	;;
esac
exit 0
