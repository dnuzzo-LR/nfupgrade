#!/usr/bin/ksh
# nf_webbuild <web tar> — print the build of the web GUI inside a LINUXWEB64
# tar, i.e. the output of the tar's own web/bin/webinfo -j:
#     { "release" : "5.4.0", "build" : "36"}
#
# Why this way: the tar's file name is not trusted for the build (the packager's
# numbered name and its unnumbered copy can both be stale or ambiguous). webinfo
# is self-contained with the build compiled in, so running the extracted copy is
# the only reliable answer. Used by the service (Patches tab checkbox) and by
# nf_patch -w (before touching rpm), so the two can never disagree about a tar.
#
# The temp dir lives under the netFLEX root (NFP_INCROOT, default /usr/cnc),
# never /tmp: STIG boxes mount /tmp noexec, so webinfo could not run there.
# Nothing else from the tar is run.
#
# Exit 0 with webinfo's output on stdout; exit 1 with one line
# "nf_webbuild: <reason>" on stderr on any failure. ksh88-safe.

INCROOT="${NFP_INCROOT:-/usr/cnc}"
TMPW=""

die() {
	print -r -u2 -- "nf_webbuild: $*"
	exit 1
}

cleanup() { [ -n "${TMPW}" ] && rm -rf "${TMPW}"; }
trap cleanup EXIT
trap 'exit 1' HUP INT TERM

[ $# -eq 1 ] && [ -n "$1" ] || die "usage: nf_webbuild <web tar>"
TAR="$1"
case "${TAR}" in
/*) ;;
*) TAR="$(pwd)/${TAR}" ;;   # tar runs after a cd into the temp dir
esac

[ -f "${TAR}" ] && [ -r "${TAR}" ] || die "cannot read ${TAR}"
# A run killed by the service's timeout (SIGKILL) cannot run its trap: remove
# temp dirs such runs left behind (older than an hour; no run takes that long).
find "${INCROOT}" -maxdepth 1 -name '.nfweb.*' -mmin +60 -exec rm -rf {} + 2>/dev/null
TMPW=$(mktemp -d "${INCROOT}/.nfweb.XXXXXX") || die "cannot make a temp dir in ${INCROOT}"

tar tf "${TAR}" > "${TMPW}/list" 2>/dev/null || die "cannot read ${TAR}"
# The packager's tar is "tar cf ... *" (member "lwebdata.Z"); allow "./" too.
MEMBER=$(grep -x '\(\./\)\{0,1\}lwebdata\.Z' "${TMPW}/list" | sed -n 1p)
[ -n "${MEMBER}" ] || die "no lwebdata.Z in ${TAR}"
(cd "${TMPW}" && tar xf "${TAR}" "${MEMBER}" > /dev/null 2>&1) && [ -f "${TMPW}/lwebdata.Z" ] \
	|| die "no lwebdata.Z in ${TAR}"

# Streamed: only webinfo is written, not the whole decompressed web tree
# (/usr/cnc may be short of space). Success is judged by the file existing,
# so the pipe's status is not needed.
(cd "${TMPW}" && gzip -dc lwebdata.Z 2>/dev/null | cpio -id web/bin/webinfo > /dev/null 2>&1)
[ -f "${TMPW}/web/bin/webinfo" ] || die "no web/bin/webinfo in lwebdata.Z"

"${TMPW}/web/bin/webinfo" -j > "${TMPW}/out" 2>/dev/null || die "webinfo did not run"
cat "${TMPW}/out"
exit 0
