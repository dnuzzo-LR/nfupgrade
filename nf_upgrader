function upgrade_new_sw
{

	STATE=`cat $STATEFILE`
	while true
	do
		loginfo "Current upgrade STATE is ${STATE}"
		case ${STATE} in
		swscomplete )
			loginfo "Staging is complete on ${HOSTNAME}, beginning upgrade to ${NEW_GENERIC}${NEW_LOAD}"
			STATE=swistart
			;;
		swistart )
			#
			# Preliminary stuff
			#
			doswistart
			STATE=swicopycnc
			;;
		swicopycnc )
			#
			# Copy the PRODUCT files (non DB).
			#
			export SHLIB_PATH=${STAGE_SHLIB_PATH}
			export LD_LIBRARY_PATH=${STAGE_LD_LIBRARY_PATH}
			doswicopycnc
			export SHLIB_PATH=${ORIG_SHLIB_PATH}
			export LD_LIBRARY_PATH=${ORIG_LD_LIBRARY_PATH}
			STATE=swipackages
			;;
		swipackages )
			if [ "$LINUXPACKAGES" = "YES" ]
			then
				dolinuxpackages
			fi
			STATE=swipreboot
			;;
		swipreboot )
			#
			# Do some preboot stuff
			#
			doswipreboot
			STATE=swiretropass2
			;;
		swiretropass2 )
			#
			# Run DB retrofit pass 2 of 3.
			#
			doswiretropass2
			STATE=swibootinc
			;;
		swibootinc )
			#
			# Boot app if requested.
			#
			doswibootinc
			STATE=postinstall

			# retrofit pass 3 will be done in new_boot_nms now
			#STATE=swiretropass3

			;;
		postinstall )
			loginfo "DO postinstall"
			run_logged post-install sh /usr/cnc/bin/post-install.sh
			loginfo "DONE postinstall"
			STATE=swidone
			;;
		swiretropass3 )
			#
			# Run DB retrofit pass 3 of 3 if app booted.
			#
			doswiretropass3
			run_logged post-install sh /usr/cnc/bin/post-install.sh
			STATE=swidone
			;;
		swidone )
			#
			#  Upgrade successfully completed.
			#
			rm -f ${STAGEROOT}
			rm -f ${SAVEDROOT}
			return
			;;
		*failed )
			logerror "If you are trying to restart the upgrade folowing a failure you must edit the state file (${STATE})."
			loginfo "       Please consult the upgrade manual."
			exit_upgrade
			;;
		* )
			logerror "Unsupported state (${STATE}) for upgrade process"
			fail_upgrade
			;;
		esac
		write_state $STATE
	done
}

#
# If either a Geographic Redundancy transfer or restore are in progress
# then wait until it completes. If the timeout is reached then bail.
#
function check_gr_inprogress
{

	SLEEP_INTRVL=60
	ELAPSED_TIME=0
	if [ -z "${MAX_ELAPSED_GR_WAIT_TIME}" ]
	then
		# default 4 hours
    		MAX_ELAPSED_GR_WAIT_TIME=14400
	fi

	if [ ! -f "${GRTRANSFER_LOCK}" ]
	then
		GRTRANSFER_STATUS="COMPLETED"
	else
		GRTRANSFER_STATUS=`cat "${GRTRANSFER_LOCK}"`
	fi

	while [ "${GRTRANSFER_STATUS}" = "IN_PROGRESS" -o -f "${GRRESTORE_LOCK}" ]
	do

		if [ "${GRTRANSFER_STATUS}" = "IN_PROGRESS" ]
		then
			WHICH_GR="TRANSFER"
		else
			WHICH_GR="RESTORE"
		fi
		loginfo "Waiting for Geographic Redundancy ${WHICH_GR} to complete...[$ELAPSED_TIME of $MAX_ELAPSED_GR_WAIT_TIME]"
		if [ "${ELAPSED_TIME}" -ge "${MAX_ELAPSED_GR_WAIT_TIME}" ]
		then
			loginfo "Upgrade Error: GR ${WHICH_GR} has gone insane. Elapsed time is ${ELAPSED_TIME}"
			fail_upgrade
		fi
		sleep ${SLEEP_INTRVL}
		let ELAPSED_TIME=${ELAPSED_TIME}+${SLEEP_INTRVL}

		if [ ! -f "${GRTRANSFER_LOCK}" ]
		then
			GRTRANSFER_STATUS="COMPLETED"
		else
			GRTRANSFER_STATUS=`cat "${GRTRANSFER_LOCK}"`
		fi
	done

	loginfo "GR check completed... continuing with install"

}

