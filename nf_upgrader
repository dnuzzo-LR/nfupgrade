if [ "${LARCH}" != "x86_64" ]
then
	if [ -f /usr/cnc/bin/dacs ]
	then
		if (file /usr/cnc/bin/dacs | grep '64-bit' >/dev/null)
		then
			loginfo "Switching to Using 64bit"
			LARCH="x86_64"
		fi
	fi
fi

loginfo "LARCH=$LARCH"


shift $((OPTIND-1))

# /usr/cnc must be a symbolic link
if [ -d "$INCROOT" -a ! -L "$INCROOT" ]
then
	logerror "$INCROOT exists as a directory. Confusion at an all time high..."
	fail_upgrade
fi
# /usr/cnc_stage must be a symbolic link
if [ -d "$STAGEROOT" -a ! -L "$STAGEROOT" ]
then
	logerror "$STAGEROOT exists as a directory. Confusion at an all time high..."
	fail_upgrade
fi
# /usr/cnc_saved must be a symbolic link
if [ -d "$SAVEDROOT" -a ! -L "$SAVEDROOT" ]
then
	logerror "$SAVEDROOT exists as a directory. Confusion at an all time high..."
	fail_upgrade
fi

if [ ${RUNOPTS} -ne 1 ]
then
	logerror "Must provide one and only one of -s or -u options"
	print_usage
	fail_upgrade
fi

if [ -n "${CONFIGFILE}" ]
then
	if [ ! -f "${CONFIGFILE}" ]
	then
		logerror "Config file (${CONFIGFILE}) not found."
		fail_upgrade
	fi
	. ${CONFIGFILE}
else
	logerror "Need config file (-f) option"
	fail_upgrade
fi

# INC or netFLEX
NF_FEATURE_FILE="/usr/cnc/features/netFLEX"
if [ -f "${NF_FEATURE_FILE}" ]
then
        PRODUCT="netFLEX";
else
        PRODUCT="INC";
fi

MPAS=""
DOMPAS=`ls -ld /usr/cnc/bin | grep mpas_bin`
if [ -n "${DOMPAS}" ]
then
        MPAS=TRUE;
fi

#
#  Initialize the card and dno databases?
#
if [ "${INIT_CARD_DB}" = "NO" ]
then
	export SKIP_CARD_DB="YES"
else
	export SKIP_CARD_DB="NO"
fi

if [ -z "${INCUPGRADEPID}" ]
then
	INCUPGRADEPID=$$
fi
UPGRADE_LOAD="inc${NEW_GENERIC}${NEW_LOAD}"
TRACEFILE="${INCLOGDIR}/${MODE}_inc_${HOSTNAME}.${INCUPGRADEPID}"
WEBTRACEFILE="${TRACEFILE}.web"
STATEFILE="${INCLOGDIR}/.${HOSTNAME}_STATE"
WEBSTATEFILE="${INCLOGDIR}/.${HOSTNAME}_web_STATE"

if [ "${PRODUCT}" = "INC" ]
then
	#
	# INC 25.1 -> 25.1
	#
	RETRO_GENERIC="${OLD_GENERIC}"
else
	#
	# Make netFLEX Generic look like INC
	# for retrofit 2.5.1 -> 25.1
	#
	G1=`echo ${OLD_GENERIC} | cut -f1 -d'.'`
	G2=`echo ${OLD_GENERIC} | cut -f2 -d'.'`
	G3=`echo ${OLD_GENERIC} | cut -f3 -d'.'`
	if [ -z "${G3}" ]
	then
		# assume INC -> netFLEX upgrade
		RETRO_GENERIC="${OLD_GENERIC}"
	else
		# assume netFLEX -> netFLEX upgrade
		RETRO_GENERIC="${G1}${G2}.${G3}"
	fi
fi

loginfo "RETRO_GENERIC: [${RETRO_GENERIC}]"

check_db_export_needed
if [ "$?" = "1" ]
then
	loginfo "A 32bit->64bit data migration is needed..."
	# netFLEX must be booted if export/import needed
	if [ ! -f "${INCROOT}/.CNC_UP" ]
	then
		loginfo "Application must be booted to continue... "
		exit_upgrade
	fi
	loginfo "Application is booted"

	# dbcheck must be clean to continue
	${INCROOT}/bin/dbcheck -AV
        if [ "$?" != "0" ]
        then
		loginfo "dbcheck -AV... failed"
		loginfo "dbcheck errors must be fixed before continuing..."
		exit_upgrade
        fi

	loginfo "dbcheck -AV is clean"

fi

if [ "${STAGE}" = "YES" ]
then
	#
	# Stage the new software
	#
	loginfo "Staging $HOSTNAME with ${UPGRADE_LOAD} (`date`)"
	if [ ! -f "${STATEFILE}" ]
	then
		#
		#  Check if load already installed.
		#
		if [ -d "${LOADROOT}/${UPGRADE_LOAD}" ]
		then
			logerror "${LOADROOT}/${UPGRADE_LOAD} exists"
			fail_upgrade
		fi
		write_state "swsstart"
	fi
	stage_new_sw
	loginfo "Staging of ${LOADROOT}/${UPGRADE_LOAD} on ${HOSTNAME} complete (`date`)"
else
	#
	# Switch to and boot the new software
	#
	loginfo "Upgrade $HOSTNAME with ${UPGRADE_LOAD} (`date`)"
	if [ ! -f "${STATEFILE}" ]
	then
		#
		#  Make sure a state file exists.
		#
		logerror "State file ${STATEFILE} doesn't exist"
		fail_upgrade
	fi
	upgrade_new_sw
	loginfo "Upgrade of ${LOADROOT}/${UPGRADE_LOAD} on ${HOSTNAME} complete (`date`)"
fi
