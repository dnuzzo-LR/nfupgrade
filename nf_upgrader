function doswscoreupgrade
{
	#
	#  If the DEPOTFILE is not set in the config file
	#  then check for a depot in the current directory.
	#
	if [ -z "${DEPOTFILE}" ]
	then
		DFILE="${PRODUCT}${ARCHTYPE}${NEW_GENERIC}"
		DEPOTFILE=`ls | grep "${DFILE}" | tail -1`
		if [ -n "${DEPOTFILE}" ] ; then
			DEPOTFILE="${PWD}/${DEPOTFILE}"
		fi
	fi

	#
	# mkdir, create link, and upgrade
	#
	if [ "${PRODUCT}" = "INC" ]
	then
		UGL=`echo $UPGRADE_LOAD| cut -c4-9`
	else
		UGL=`echo $UPGRADE_LOAD| cut -c4-10`
	fi
	loginfo "Upgrading from ${OLD_GENERIC}${OLD_LOAD} to ${UGL}"
	loginfo "Linking ${LOADROOT}/${UPGRADE_LOAD} to ${STAGEROOT}"
	mkdir ${LOADROOT}/${UPGRADE_LOAD} 2>/dev/null
	umask 002
	rm -f ${STAGEROOT}
	/usr/bin/ln -s ${LOADROOT}/${UPGRADE_LOAD} ${STAGEROOT}
	if [ "$?" != "0" ]
        then
                logerror "Couldn't create staging link. You must have root permission."
                fail_upgrade
        fi
	umask 000


	#
	#  Don't allow upgrade to run during
	#  Geographic Redundancy transfer
	#
	check_gr_inprogress

	#
	#  Lock out daily_update and Geographic Redundancy.
	#  Create a lock file in both directories
	#  so when we switch the link it remains locked.
	#
	touch ${INC_UPGRADE_LOCK}
	touch ${STAGE_UPGRADE_LOCK}
	printf "${OLD_GENERIC}\n" > ${STAGEROOT}/.OLD_GENERIC
	printf "${OLD_LOAD}\n" > ${STAGEROOT}/.OLD_LOAD


	loginfo "Staging CORE and GUI filesets from depot [${DEPOTFILE}], please wait..."
	if [ "${ARCHTYPE}" = "LINUX" ] ; then
		PKGV=`rpm -qi netFLEX-CORE  2>/dev/null | grep Version | tail -1 | cut -d':' -f2 | xargs`
		RPM="netFLEX-CORE-${PKGV}-1.${LARCH}"
		if [ ! -d /usr/cnc_stage ]
		then
			# Only do this when there is no /usr/cnc_stage directory
			printf "rpm -e ${RPM}\n" > ${TRACEFILE}.rpm 2>&1
			rpm -e ${RPM} >> ${TRACEFILE}.rpm 2>&1
		fi
		printf "rpm -ivh --replacepkgs --replacefiles ${DEPOTFILE}\n" >> ${TRACEFILE}.rpm 2>&1
		rpm -ivh --replacepkgs --replacefiles ${DEPOTFILE} >> ${TRACEFILE}.rpm 2>&1
		if [ $? != 0 ]
		then
			logerror "software install failed"
			rm -f ${STAGEROOT}
			rm -rf ${LOADROOT}/${UPGRADE_LOAD}
			fail_upgrade
		fi
	else
		logerror "Unrecognized architecture detected"
		exit_upgrade
	fi

	#
	# Check for Extensions. Could be set from upgrade.cfg file.
	#
        if [ -z "${EXTDEPOTFILE}" ]
        then

		loginfo "Checking for customer extensions"
		if [ -f "${INCROOT}/features/ATT" ]
		then
			if [ "${ARCHTYPE}" = "LINUX" ]
			then
				AFILE="INC-ATT-${NEW_GENERIC}.${NEW_LOAD}-1.${LARCH}.rpm"
			else
				logerror "Unrecognized architecture detected"
				exit_upgrade
			fi
                	EXTDEPOTFILE=`ls | grep "${AFILE}" | grep -v PATCH | tail -1`
			if [ -n "${EXTDEPOTFILE}" ]
			then
				# in local directory
				EXTDEPOTFILE="${PWD}/${EXTDEPOTFILE}"
				loginfo "Look for ATT depot in local directory [${EXTDEPOTFILE}]"
			fi
		else
			loginfo "No extension configuration found"
		fi
	else
		loginfo "Using EXTDEPOTFILE define from config file"
    fi

	#
	# If able to resolve an extension, try to install.
	#
	if [ -f "${EXTDEPOTFILE}" ]
	then
		loginfo "Staging EXTENSION fileset from depot [${EXTDEPOTFILE}], please wait..."
		#
		# Only AT&T extensions supported as of now.
		#
		if [ -f "${INCROOT}/features/ATT" ]
		then
			if [ "${ARCHTYPE}" = "LINUX" ]
			then
				printf "rpm -ivh --replacepkgs --replacefiles ${EXTDEPOTFILE}\n" >> ${TRACEFILE}ATTEXT.rpm 2>&1
				rpm -ivh --replacepkgs --replacefiles ${EXTDEPOTFILE} >> ${TRACEFILE}ATTEXT.rpm 2>&1
				if [ $? != 0 ]
				then
					logerror "ATT software install failed"
					fail_upgrade
				fi
			else
				logerror "Unrecognized architecture detected"
				exit_upgrade
			fi
		else
			logerror "Invalid EXTENSION configuration... software install failed"
			fail_upgrade
		fi
	elif [ -n "${EXTDEPOTFILE}" ]
	then
		logerror "EXTENSION configuration file [${EXTDEPOTFILE}] not found... software install failed"
		fail_upgrade
	fi

}

