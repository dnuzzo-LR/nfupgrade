function calc_stage_space
{
	#
	# Verify sufficient space to upgrade.
	#
	OLDDIR=`pwd`
	cd ${INCROOT}

	#
	#  Calculate space needed from current system minus db, logs, trace.
	#  Skip RDB since those files get moved from olddir to newdir.
	#
	if [ "${REMOVEINCLOGS}" = "YES" ]
	then
		SKIPDIRS="logs db trace me2pmfiles hist ne_backups download rdb"
	else
		SKIPDIRS="db trace me2pmfiles hist ne_backups download rdb"
	fi
	let SPACE_USED=`du . | tail -1 | cut -f1`
	ORIG_SPACE_USED=${SPACE_USED}
	for INCDIR in $SKIPDIRS
	do
		if [ -d "./${INCDIR}" ]
		then
			let SPACE_TMP=`du ./${INCDIR} | tail -1 | cut -f1`
			let SPACE_USED=`expr ${SPACE_USED}-${SPACE_TMP}`
		fi
	done
	cd ${OLDDIR}

	#
	#  If we are going to be deleting a directory
	#  then don't count that in the space needed.
	#
	if [ -n "${UNLINKDIR}" -a -d "${UNLINKDIR}" ]
	then
		let SPACE_REMOVED=`du ${UNLINKDIR} | tail -1 | cut -f1`
	else
		let SPACE_REMOVED=0
	fi

	PAD_PERCENT=10
	let PAD=`expr ${SPACE_USED}/${PAD_PERCENT}`
	let SPACE_NEEDED=`expr ${SPACE_USED}+${PAD}`
	let SPACE_NEEDED=`expr ${SPACE_NEEDED}-${SPACE_REMOVED}`

	if [ "${ARCHTYPE}" = "LINUX" ] ; then
		let SPACE_AVAIL=`/usr/bin/df ${LOADROOT} | grep -v Filesystem | awk '{print $4;}'`
	else
		logerror "Unrecognized architecture detected"
		exit_upgrade
	fi

	let KSPACE_AVAIL=`expr ${SPACE_AVAIL}/2`
	let KSPACE_NEEDED=`expr ${SPACE_NEEDED}/2`

	loginfo "Space available in ${LOADROOT} is ${KSPACE_AVAIL} Kbytes"
	loginfo "Space needed to stage is ${KSPACE_NEEDED} Kbytes"

	#
	# Check for sufficient available space
	#
	if [ ${KSPACE_AVAIL} -lt ${KSPACE_NEEDED} ]
	then
		logerror "Insufficient space to complete staging"
		fail_upgrade
	fi
}

function calc_retrofit_space
{
	if [ "${ARCHTYPE}" = "LINUX" ] ; then
		let SPACE_AVAIL=`/usr/bin/df ${LOADROOT} | grep -v Filesystem | awk '{print $4;}'`
	else
		logerror "Unrecognized architecture detected"
		exit_upgrade
	fi
	let KSPACE_AVAIL=`expr ${SPACE_AVAIL}/2`
	KRSPACE_NEEDED=`${STAGEROOT}/bin/stage_retrofit -s -r ${RETRO_GENERIC}`

	loginfo "Space available in ${LOADROOT} is ${KSPACE_AVAIL} Kbytes"
	loginfo "Space needed to retrofit is ${KRSPACE_NEEDED} Kbytes"

	#
	# Check for sufficient available space
	#
	if [ ${KSPACE_AVAIL} -lt ${KRSPACE_NEEDED} ]
	then
		logerror "Insufficient space to complete retrofit"
		fail_upgrade
	fi
}

function export_gshm
{
	let SPACE_AVAIL=`/usr/bin/df ${LOADROOT} | grep -v Filesystem | awk '{print $4;}'`
	let KSPACE_AVAIL=`expr ${SPACE_AVAIL}/2`
	KESPACE_NEEDED=`${INCROOT}/mbin/shmjson -x`

	loginfo "Space available in ${LOADROOT} is ${KSPACE_AVAIL} Kbytes"
	loginfo "Space needed to export GSHM data is ${KESPACE_NEEDED} Kbytes"

	#
	# Check for sufficient available space
	#
	if [ ${KSPACE_AVAIL} -lt ${KESPACE_NEEDED} ]
	then
		logerror "Insufficient space to complete GSHM export"
		fail_upgrade
	fi

	#
	# Export data to new netFLEX directory for future import
	#
	loginfo "Exporting GSHM data to ${EXPORTDIR}"
	if [ ! -d "${EXPORTDIR}" ]
	then
		mkdir ${EXPORTDIR}
		if [ "$?" != "0" ]
		then
			logerror "failed to create data export directory: ${EXPORTDIR}"
			fail_upgrade
		fi
	fi

	SHMDIR=${EXPORTDIR}/shm
	if [ ! -d "${SHMDIR}" ]
	then
		mkdir ${SHMDIR}
		if [ "$?" != "0" ]
		then
			logerror "failed to create data export directory: ${SHMDIR}"
			fail_upgrade
		fi
	fi

	#
	# need to export using shmjson from currently installed netFLEX
	#
	${INCROOT}/mbin/shmjson -e -f -d ${SHMDIR}
	if [ "$?" != "0" ]
	then
		logerror "failed to export GSHM data to export directory: ${SHMDIR}"
		fail_upgrade
	fi
	loginfo "Completed exporting GSHM data to ${SHMDIR}"
	
}

function export_ctree_db
{
	let SPACE_AVAIL=`/usr/bin/df ${LOADROOT} | grep -v Filesystem | awk '{print $4;}'`
	let KSPACE_AVAIL=`expr ${SPACE_AVAIL}/2`
	KESPACE_NEEDED=`${INCROOT}/mbin/inc_db export --estimate`

	loginfo "Space available in ${LOADROOT} is ${KSPACE_AVAIL} Kbytes"
	loginfo "Space needed to export ctree data is ${KESPACE_NEEDED} Kbytes"

	#
	# Check for sufficient available space
	#
	if [ ${KSPACE_AVAIL} -lt ${KESPACE_NEEDED} ]
	then
		logerror "Insufficient space to complete ctree export"
		fail_upgrade
	fi

	#
	# Export data to new netFLEX directory for future import
	#
	EXPORTDIR="${STAGEROOT}/export"
	loginfo "Exporting Ctree data to ${EXPORTDIR}"
	if [ ! -d "${EXPORTDIR}" ]
	then
		mkdir ${EXPORTDIR}
		if [ "$?" != "0" ]
		then
			logerror "failed to create data export directory: ${EXPORTDIR}"
			fail_upgrade
		fi
	fi

	CTREEDIR=${EXPORTDIR}/ctree
	if [ ! -d "${CTREEDIR}" ]
	then
		mkdir ${CTREEDIR}
		if [ "$?" != "0" ]
		then
			logerror "failed to create data export directory: ${CTREEDIR}"
			fail_upgrade
		fi
	fi

	#
	# need to export using inc_db from currently installed netFLEX
	#
	${INCROOT}/mbin/inc_db export -D ${CTREEDIR} -C gzip
	if [ "$?" != "0" ]
	then
		logerror "failed to export ctree data to export directory: ${CTREEDIR}"
		fail_upgrade
	fi

	${INCROOT}/bin/cli_migrate > ${EXPORTDIR}/cli.export
	if [ "$?" != "0" ]
	then
		logerror "failed to export cli data to export directory: ${EXPORTDIR}"
		fail_upgrade
	fi

	cp ${INCROOT}/tables/cli.dcs ${EXPORTDIR}/cli.dcs.copy	

	loginfo "Completed exporting Ctree data to ${CTREEDIR}"
	
}

function check_db_export_needed
{
	TARGET64="NO"
	IMPORT_NEEDED="0"
        loginfo "Checking if database export is needed..."

	if [ "${MACHTYPE}" = "BEP" ]
	then
		IMPORT_NEEDED="0"
		export IMPORT_NEEDED
		return ${IMPORT_NEEDED}
	fi

	# Is 64bit?
        STR64BIT="64-bit"
        file /usr/cnc/bin/dacs | grep "${STR64BIT}" >/dev/null
        if [ "$?" = "0" ]
        then
                TARGET64="YES"
        	loginfo "64BIT already installed"
        else
                file /usr/cnc_stage/bin/dacs | grep "${STR64BIT}" >/dev/null
                if [ "$?" = "0" ]
                then
                        TARGET64="YES"
			IMPORT_NEEDED="1"
                fi
        fi

        loginfo "64BIT=[${TARGET64}]"
	loginfo "MACHTYPE=[$MACHTYPE]"
	if [ "${TARGET64}" = "YES" -a "${IMPORT_NEEDED}" = "1" -a "${MACHTYPE}" != "BEP" ]
	then

		# Check if export/import previously done
		SHM_IMPORT_DONE_FILE=${IMPORTDIR}/shm_import_done
		if [ -f "${SHM_IMPORT_DONE_FILE}" ]
		then
			IMPORT_NEEDED="0"
			loginfo "GSHM import previously marked done (${SHM_IMPORT_DONE_FILE}). NOT triggering GSHM and ctree import for this upgrade..."
		fi

		CTREE_IMPORT_DONE_FILE=${IMPORTDIR}/ctree_import_done
		if [ -f "${CTREE_IMPORT_DONE_FILE}" ]
		then
			IMPORT_NEEDED="0"
			loginfo "ctree import previously marked done (${CTREE_IMPORT_DONE_FILE}). NOT triggering GSHM and ctree import for this upgrade..."
		fi
	fi

	if [ "${IMPORT_NEEDED}" = "0" ]
	then
		loginfo "GSHM/ctree export/import NOT needed..."
	else
		loginfo "GSHM/ctree export/import IS needed..."
	fi

	# IMPORT_NEEDED by retrofit to not copy ctree files from old dir
	export IMPORT_NEEDED
	return ${IMPORT_NEEDED}

}

function export_dbs
{
        loginfo "database export is starting..."

	loginfo "Exporting GSHM..."
	export_gshm

	loginfo "Exporting ctree databases..."
	export_ctree_db

	# Create touch file to trigger import
	IMPORT_NEEDED_FILE="${EXPORTDIR}/import_needed"
	loginfo "Creating ${IMPORT_NEEDED_FILE} control file to trigger GSHM and ctree import for this upgrade..."
	touch ${IMPORT_NEEDED_FILE}
}


function stop_inc
{
	loginfo "Saving equipment info in ${INCROOT}"
	${INCROOT}/ambin/equdump all > ${INCROOT}/curr_equip.out

	loginfo "Saving nestat info in ${INCROOT}"
	${INCROOT}/mbin/nestat -a > ${INCROOT}/curr_nestat.out

	loginfo "Saving dbcheck info in ${INCROOT}"
	${INCROOT}/bin/dbcheck -AV > ${INCROOT}/curr_dbcheck-AV.out

	touch ${INCROOT}/CNCDISABLE

	loginfo "Looking for USER procs"
	ps -e | grep USER | while read pid b c proc
	do
		if [ "$proc" = "USER" ]
		then
			loginfo "Killing USER pid:$pid"
			kill -9 $pid
		fi
	done

	# Export databases if 64bit migration needed
	check_db_export_needed
	if [ "$?" = "1" ]
	then
		export_dbs
	fi

	#
	#  Shut the system down
	#
	NBOPT="-P $$:$PPID"

	loginfo "Bringing down the application"
	loginfo "${INCROOT}/bin/new_boot_nms remote_shutdown ${NBOPT}"
	${INCROOT}/bin/new_boot_nms remote_shutdown ${NBOPT}
	
	#
	#  There is a problem where some processes don't
	#  die from new_boot_nms shutdown. We should do
	#  some cleanup on the known offenders.
	#
	loginfo "Looking for residual procs"
	for name in lan nxdi intrfc sdi md_wtr md_rdr
	do
		ps -e | grep $name | while read pid b c proc
		do
			if [ "$proc" = "$name" ]
			then
				loginfo "Killing $proc pid:$pid"
				kill -9 $pid
			fi
		done
	done

}

COMMON_PG_BIN_DIRS=(
    "/usr/bin"
    "/usr/local/bin"
    "/usr/pgsql-$PG_VERSION/bin"
    "/opt/postgresql/bin"
)

function find_pg_dump
{
	#
	# Function to search for pg_dump in the PATH and common directories.
	# PostgreSQL binaries can appear in different locations and are not always in the PATH.
	#

    # First, check if pg_dump is in the PATH
    PG_DUMP=$(which pg_dump 2>/dev/null)

    if [ -n "$PG_DUMP" ]; then
        #echo "pg_dump found in PATH: $PG_DUMP"
        return 0
    fi

    # If not found in PATH, search in common directories
    for dir in "${COMMON_PG_BIN_DIRS[@]}"; do
        if [ -x "$dir/pg_dump" ]; then
            PG_DUMP="$dir/pg_dump"
            #echo "pg_dump found in directory: $PG_DUMP"
            return 0
        fi
    done

    # If pg_dump is still not found, print an error message
    echo "Error: pg_dump not found in PATH or common directories." >&2
    return 1
}

function backup_rdb
{
	#
	# Dump the RDB only on Linux machines. Used for rollback.
	# The .RESTORE file tells "rdb init" to overwrite the DB on app boot with saved backup.
	#
	get_data_dir
	if [ "$RDB_LOCATION" = "remote" ] || { [ "$RDB_LOCATION" = "fep" ] && [ "$RDB_MACHTYPE" != "NMS" ]; }
	then
		loginfo "RDB is not local to this server. Skipping RDB backup."
		return 0
	fi
	if [ "${ARCHTYPE}" = "LINUX" -a -d ${INCROOT}/rdb ]
	then
		loginfo "Backing up RDB to ${INCROOT}/rdb/backup"
		
                if /usr/cnc/bin/rcmd sh /usr/cnc_stage/bin/rdb_tar_backup.sh; then
                        loginfo "RDB Backup successful"
                else
                        loginfo "Backup failed using tar method. Switching to old backup method. Restore will be manual."
                        systemctl start postgresql-$PG_VERSION
                        ${INCROOT}/bin/rdbpwd set
                        touch ${INCROOT}/rdb/backup/.RESTORE

                        find_pg_dump
                        $PG_DUMP -U cmm -Fc otn_port > ${INCROOT}/rdb/backup/otn_port.sql
                        $PG_DUMP -U cmm -Fc inc > ${INCROOT}/rdb/backup/inc.sql

                        ${INCROOT}/bin/rdbpwd remove
                        systemctl stop postgresql-$PG_VERSION

                fi
	
	fi

}

