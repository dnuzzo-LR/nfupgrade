function doswspatchinstall
{
	#
	#  If there is a PATCH for this release,
	#  install it now.
	#

	PATCHDEPOTFILE=""
	ATTEXTPATCHDEPOTFILE=""

	#
	#  If the PATCHDEPOTFILE is not set in the config file
	#  then check for a patch depot in the current directory.
	#
	if [ -z "${PATCHDEPOTFILE}" ]
	then
		if [ "${ARCHTYPE}" = "LINUX" ]
		then
			PATCHDEPOTFILE=`ls | grep "${PRODUCT}-CORE-.*PATCH-${NEW_GENERIC}.*-1.${LARCH}.rpm" | tail -1`
		else
			logerror "Unrecognized architecture detected"
			exit_upgrade
		fi
		if [ -n "${PATCHDEPOTFILE}" ]
		then
			PATCHDEPOTFILE="${PWD}/${PATCHDEPOTFILE}"
		fi
	fi

	#
	#  If the ATTEXT PATCHDEPOTFILE is not set in the config file
	#  then check for a patch depot in the current directory.
	#
	if [ -z "${ATTEXTPATCHDEPOTFILE}" ]
	then
		ATTEXTPATCHDEPOTFILE=`ls | grep "${PRODUCT}ATTEXT${ARCHTYPE}${NEW_GENERIC}.*PATCH" | tail -1`
		if [ -n "${ATTEXTPATCHDEPOTFILE}" ]
		then
			ATTEXTPATCHDEPOTFILE="${PWD}/${ATTEXTPATCHDEPOTFILE}"
		fi
        fi

	#
        #  Back up GUIs if installing patch depot
        #
	if [ -n "${PATCHDEPOTFILE}" -o -n "${ATTEXTPATCHDEPOTFILE}" ]
	then
		loginfo "Upgrading PATCH filesets from depot, please wait..."

		#
		#  Back up current GUIs in case they are in the patch.
		#
		
		for GUI in LINUX
		do
			if [ -f "${STAGEROOT}/GUI_REL/${GUI}.tar" ]
			then
				loginfo "Archiving ${GUI} GUI..."
				mv ${STAGEROOT}/GUI_REL/${GUI}.tar ${STAGEROOT}/GUI_REL/${GUI}.${NEW_GENERIC}${NEW_LOAD}.tar
			fi
		done
	fi

	#
        #  Install CORE PATCH if needed.
        #
	if [ -n "${PATCHDEPOTFILE}" ]
	then
		loginfo "Installing PATCH filesets, please wait..."
		if [ "${ARCHTYPE}" = "LINUX" ]
		then
			echo "rpm -e ${RPM}" > ${TRACEFILE}.rpm_patch 2>&1
			rpm -e ${RPM} >> ${TRACEFILE}.rpm_patch 2>&1
			echo "rpm -ivh --replacepkgs --replacefiles ${PATCHDEPOTFILE}" >> ${TRACEFILE}.rpm_patch 2>&1
			rpm -ivh --replacepkgs --replacefiles ${PATCHDEPOTFILE} >> ${TRACEFILE}.rpm_patch 2>&1
			if [ $? != 0 ]
			then
				logerror "patch software install failed"
				fail_upgrade
			fi
		else
			logerror "Unrecognized architecture detected"
			exit_upgrade
		fi
	fi

	#
        #  Install ATT EXT PATCH if needed.
        #
	if [ -n "${ATTEXTPATCHDEPOTFILE}" ]
	then
		loginfo "Installing ATT EXT PATCH filesets, please wait..."
		if [ "${ARCHTYPE}" = "LINUX" ]
		then
			echo "rpm -e ${RPM}" > ${TRACEFILE}.rpm_patch 2>&1
			rpm -e ${RPM} >> ${TRACEFILE}.rpm_patch 2>&1
			echo "rpm -ivh --replacepkgs --replacefiles ${ATTEXTPATCHDEPOTFILE}" >> ${TRACEFILE}.rpm_patch 2>&1
			rpm -ivh --replacepkgs --replacefiles ${ATTEXTPATCHDEPOTFILE} >> ${TRACEFILE}.rpm_patch 2>&1
			if [ $? != 0 ]
			then
				logerror "ATT patch software install failed"
				fail_upgrade
			fi
		else
			logerror "Unrecognized architecture detected"
			exit_upgrade
		fi
	fi

	#
        #  Restore GUIs if installing patch depot
        #
	if [ -n "${PATCHDEPOTFILE}" -o -n "${ATTEXTPATCHDEPOTFILE}" ]
	then
		#
		#  Restore original GUIs if they are not in the patch.
		#
		
		for GUI in LINUX
		do
			if [ ! -f "${STAGEROOT}/GUI_REL/${GUI}.tar" ]
			then
				loginfo "${GUI} GUI not patched, restoring ${GUI} GUI..."
				mv ${STAGEROOT}/GUI_REL/${GUI}.${NEW_GENERIC}${NEW_LOAD}.tar ${STAGEROOT}/GUI_REL/${GUI}.tar
			else
				loginfo "${GUI} GUI was patched..."
			fi
		done
	else
		loginfo "No PATCH fileset to install... skipping"
	fi
}

