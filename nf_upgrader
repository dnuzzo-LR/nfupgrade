#
# Master staging function.
#
function stage_new_sw
{

	STATE=`cat $STATEFILE`

	while true
	do
		loginfo "Current staging STATE is ${STATE}"
		case ${STATE} in
		swsstart )
			#
			# Preliminary stuff
			#
			doswsstart
			#
			# Calculate required staging space
			#
			calc_stage_space
			#
			# sw install core depot
			#
			doswscoreupgrade
			STATE=swspatchinstall
			;;
		swspatchinstall )
			#
			# Install patch if necessary
			#
			doswspatchinstall
			STATE=swswebinstall
			;;
		swswebinstall )
			#
			#  Upgrade the WEB if necessary
			#
			doswswebinstall
			STATE=swscopycnc
			;;
		swscopycnc )
			#
			# Copy the PRODUCT files - first pass (non DB).
			#
			export SHLIB_PATH=${STAGE_SHLIB_PATH}
			export LD_LIBRARY_PATH=${STAGE_LD_LIBRARY_PATH}
			doswscopycnc
			export SHLIB_PATH=${ORIG_SHLIB_PATH}
			export LD_LIBRARY_PATH=${ORIG_LD_LIBRARY_PATH}
			STATE=swsretropass1
			;;
		swsretropass1 )
			export SHLIB_PATH=${STAGE_SHLIB_PATH}
			export LD_LIBRARY_PATH=${STAGE_LD_LIBRARY_PATH}
			#
			# Verify space required for retrofit
			#
			calc_retrofit_space
			#
			# Run DB retrofit pass 1 of 3
			#
			doswsretropass1
			export SHLIB_PATH=${ORIG_SHLIB_PATH}
			export LD_LIBRARY_PATH=${ORIG_LD_LIBRARY_PATH}
			STATE=swscomplete
			;;
		swscomplete )
			#
			#  Staging successfully completed.
			#
			return
			;;
		swidone )
			logerror "Unsupported state (${STATE}) for staging process."
			loginfo "       If this is a new upgrade, please remove the state"
			loginfo "       file (${STATEFILE}) before"
			loginfo "       beginning the staging process."
			fail_upgrade
			;;
		*failed )
			logerror "If you are trying to restart the upgrade following a staging failure you must edit the state file (${STATE})."
			loginfo "       Please consult the upgrade manual."
			exit_upgrade
			;;
		* )
			logerror "Unsupported state (${STATE}) for staging process"
			fail_upgrade
			;;
		esac
		write_state $STATE
	done
}

function doswistart
{
	FAIL_UPGRADE=0

	#
	# Bring down the APP
	#
	APP_WAS_RUNNING="NO"
	if [ -f "${INCROOT}/.CNC_UP" -o -f "${INCROOT}/.MUX_UP" ]
	then
		APP_WAS_RUNNING="YES"
	fi

	stop_inc
	backup_rdb

	loginfo "Cleaning up trace files"
	rm -f ${INCROOT}/trace/*

	loginfo "Checking if printers enabled"
	lpshut 2> /dev/null
	LPRESULT="$?"
	if [ "${LPRESULT}" = 0 ]
	then
		# will be turned back on by new_boot_nms
		loginfo "Printers shut down"
	else
		loginfo "No printers enabled"
	fi
	printf "${LPRESULT}\n" > ${STAGEROOT}/.LPRESULT

	#
	# Some dld.sl.conf files are custom so preserve
	#
	if [ -f /etc/dld.sl.conf ]
	then
		rm /etc/dld.sl.conf.${PID}
		cp /etc/dld.sl.conf /etc/dld.sl.conf.${PID}
	fi

	if [ $? != 0 ]
	then
		FAIL_UPGRADE=1
	fi

	#
	# If dld.sl.conf was preserved, restore it.
	#
	if [ -f /etc/dld.sl.conf.${PID} ]
	then
		mv -f /etc/dld.sl.conf /etc/dld.sl.conf.preupgrade
		mv /etc/dld.sl.conf.${PID} /etc/dld.sl.conf
		chmod 744 /etc/dld.sl.conf
	fi

	if [ "${FAIL_UPGRADE}" = "1" ]
	then
		logerror "software install failed"
		fail_upgrade
	fi

}

function doswicopycnc
{
	#
	#  Set up the database.
	#
	cd ${INCROOT}/features
	loginfo "Copying PASS 2 files from ${COPYCNCLOC}, please wait..."
	rm -rf ${COPYCNCLOC}/GUI_REL
	rm -rf ${COPYCNCLOC}/floppy
	rm -f ${COPYCNCLOC}/lib/*:*
	#rm -rf ${COPYCNCLOC}/tools/*
	rm -rf ${COPYCNCLOC}/trace/*
	find ${COPYCNCLOC}/data -name core -exec rm -f {} \;

	if [ "${REMOVEINCLOGS}" = "YES" ]
	then
		rm -rf ${COPYCNCLOC}/logs/*
	fi

	if [ "${CLEANUPPROCDIR}" = "YES" ]
	then
		find ${COPYCNCLOC}/procs -type f -exec rm -f {} \;
	fi

	printf "${STAGEROOT}/bin/copy_cnc -d ${COPYCNCLOC} -p 2\n"  > /dev/null  # reference inc877898 do not remove
	${STAGEROOT}/bin/copy_cnc -d ${COPYCNCLOC} -p 2 >> ${TRACEFILE}.copy_cnc 2>&1 <<EOF
y
y
y
y
y
y
EOF
	if [ "$?" != "0" ]
        then
                logerror "Failed PASS 2 of copy_cnc."
                fail_upgrade
        fi
	loginfo "Copying PASS 2 files from ${COPYCNCLOC} complete"
	ls -la /usr/cnc_stage/backup



	loginfo "Managing RDB files..."
	# Move the RDB files
	if [ -d "${STAGEROOT}/rdb/data" ]
	then
		logerror "${STAGEROOT}/rdb/data directory found!!!"
		fail_upgrade
	fi

	# Must skip rdb data move if rdb data is located outside of /usr/cnc
	# External rdb data loc can be found by running rdb curdir if server is up
	# Or can be found in /usr/cnc/features/rdb file using 'data_directory=' i.e. data_directory=/usr4/netflex_extra/rdb/data
	rdbmove="TRUE" # skip RDB data move if located outside of /usr/cnc/rdb/data

	# If the postgresql.conf file exists, we can move the directory. Better safe than sorry.
	# The move shouldn't hurt anything, even if the curdir is outside /usr/cnc/rdb/data.
	PG_CONF_FILE="${INCROOT}/rdb/data/postgresql.conf"
	if [ ! -f "${PG_CONF_FILE}" ]
	then
		# Failsafe code in case there is no postgresql.conf, but the curdir is still
		# set to /usr/cnc/rdb/data (shouldn't happen). Possibly trigger an error...

		output=$(/usr/cnc/bin/rdb curdir 2>&1)
		if [[ $output == "Failed to fetch current data directory" ]]; then # RDB is potentially stored elsewhere
			temp=$(cat /usr/cnc/features/rdb 2>&1 | grep "^data_directory=")
			if [[ -f /usr/cnc/features/rdb && -n $temp && $temp != *"/usr/cnc/rdb/data"* ]]; then
				rdbmove="FALSE"
			fi
		elif [[ $output != "/usr/cnc/rdb/data" ]]; then
			rdbmove="FALSE"
		fi
	fi

	if [[ $rdbmove == "FALSE" ]]; then
		loginfo "rdb data is external to /usr/cnc. Skipping rdb data move"
	else
		loginfo "Moving ${INCROOT}/rdb/data to ${STAGEROOT}/rdb/data"
		mv ${INCROOT}/rdb/data ${STAGEROOT}/rdb/data
		if [ "$?" != "0" ]
		then
			logerror "Move ${INCROOT}/rdb/data to ${STAGEROOT}/rdb/data failed!!!"
			fail_upgrade
		fi
	fi

	# This is not needed and in a GR configuration it caused the filesystem to fill up.
	#printf "Copying ${INCROOT}/rdb/backup/* to ${STAGEROOT}/rdb/backup\n"
	#cp -r $INCROOT/rdb/backup/* ${STAGEROOT}/rdb/backup

	loginfo "Copying ${INCROOT}/rdb/config/* to ${STAGEROOT}/rdb/config"
	cp -r $INCROOT/rdb/config/* ${STAGEROOT}/rdb/config

	loginfo "Finished managing RDB files..."

}

function doswipreboot
{
	#
	#  Prepare to bring the system back up.
	#  Remove all links especially SAVEDROOT
	#  and STAGEROOT so the swremove doesn't
	#  physically remove any libs or executables.
	#
	ls -la /usr/cnc_stage/backup

	umask 002
	rm -f ${INCROOT}
	rm -f ${SAVEDROOT}
	rm -f ${STAGEROOT}

	ls -la /usr/cnc_stage/backup

	#
	#  Set up to bring the system back up.
	#  Reestablish the links.
	#
	/usr/bin/ln -s ${LOADROOT}/${UPGRADE_LOAD} ${STAGEROOT}
	/usr/bin/ln -s ${LOADROOT}/${UPGRADE_LOAD} ${INCROOT}
	/usr/bin/ln -s ${RETROROOT} ${SAVEDROOT}
	ls -la /usr/cnc/backup
	umask 000
}

