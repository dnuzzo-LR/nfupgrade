#Get RDB data directory and PostgreSQL version


#Get PostgreSQL data directory
get_data_dir () {

#Get RDB server location (local/fep/remote). Missing entry defaults to local.
grep rdb_server_location /usr/cnc/features/rdb >/dev/null 2>&1
if (( $? == 0 ))
then
        RDB_LOCATION=$(grep ^"rdb_server_location=" /usr/cnc/features/rdb | cut -d= -f2 | tr -d '\n')
else
        RDB_LOCATION=local
fi

#Remote database: no local data directory on this server, skip the check
if [ "$RDB_LOCATION" = "remote" ]
then
        loginfo "RDB location is remote. Skipping local database directory check."
        return 0
fi

#FEP mode: only the FEP (mach_type NMS) hosts the database. BEPs connect to
#the FEP RDB, so they have no local data directory to check.
if [ "$RDB_LOCATION" = "fep" ]
then
        RDB_MACHTYPE=$(${INCROOT}/bin/mach_type | tr -d '[:space:]')
        if [ "$RDB_MACHTYPE" != "NMS" ]
        then
                loginfo "RDB location is fep and this is a BEP server. Skipping local database directory check."
                return 0
        fi
        loginfo "RDB location is fep and this is the FEP server. Checking local database directory."
fi

grep data_directory /usr/cnc/features/rdb >/dev/null 2>&1
if (( $? == 0 ))
then
        PGDATA=$(grep ^"data_directory=" /usr/cnc/features/rdb | cut -d= -f2 | tr -d '\n')
else
        PGDATA=/usr/cnc/rdb/data
fi

#Check if data directory exists or not
if [ -d "$PGDATA" ]; then
    loginfo "Database Directory Exists at $PGDATA"
elif [ -f ${INCROOT}/rdb/backup/.RESTORE ]; then
    loginfo "RDB Database should be restored from backup"
else
    loginfo " Database directory doesn't exist. Exiting now."
    exit 1;
fi

#Get PostgreSQL version
PG_VERSION=$(/usr/cnc/bin/rcmd cat "$PGDATA/PG_VERSION")
loginfo "PostgreSQL version is $PG_VERSION"
}


